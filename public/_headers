# Cloudflare Workers static assets: explicit content types for files Next.js
# emits without an extension, plus sane caching for the hashed build output.
/opengraph-image
  Content-Type: image/png
/about/opengraph-image
  Content-Type: image/png
/apps/:slug/opengraph-image
  Content-Type: image/png
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
